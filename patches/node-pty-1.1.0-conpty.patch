+// Only the watcher closes a connected console. A failed connect has no watcher
+// and uses this same helper while unwinding. The JS thread only requests close.
+static void close_pty_baton(const std::shared_ptr<pty_baton>& handle) {
+  HPCON hpc;
+  HANDLE hIn, hOut;
+  {
+    std::lock_guard<std::mutex> lock(handle->mutex);
+    hpc = std::exchange(handle->hpc, nullptr);
+    hIn = std::exchange(handle->hIn, nullptr);
+    hOut = std::exchange(handle->hOut, nullptr);
+  }
+  // No global/baton lock is held while the independent conout worker and JS
+  // consumer drain output. ClosePseudoConsole may wait for that drain.
+  if (hpc != nullptr) {
+    handle->closePseudoConsole(hpc);
+    --livePseudoconsoles;
+  }
+  if (hIn != nullptr && hIn != INVALID_HANDLE_VALUE) CloseHandle(hIn);
+  if (hOut != nullptr && hOut != INVALID_HANDLE_VALUE) CloseHandle(hOut);
