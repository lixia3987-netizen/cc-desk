+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { registerSessionHandlers } from '../src/main/ipc/session-handlers';
+import type { Register } from '../src/main/ipc/registration';
+test('session info is read-only, validates its id and omits private fields',()=>{
+  const handlers=new Map<string,{schema:{parse(value:unknown):unknown};action:(value:any)=>unknown}>();
+  const session={id:'11111111-1111-4111-8111-111111111111',title:'Fixture',archived:false,cwd:'/private',engineConfig:{token:'private'},execution:{providerId:'native',mode:'structured'}};
+  const saved=JSON.stringify(session);
+  registerSessionHandlers(((name,schema,action)=>handlers.set(name,{schema,action})) as Register,{session:(id:string)=>{assert.equal(id,session.id);return session;}} as unknown as Parameters<typeof registerSessionHandlers>[1]);
+  const handler=handlers.get('session:info')!;
+  assert.throws(()=>handler.schema.parse('bad'));
+  assert.deepEqual(handler.action(handler.schema.parse(session.id)),{sessionId:session.id,title:'Fixture',archived:false,providerId:'native',mode:'structured',workspaceKind:'project'});
+  assert.equal(JSON.stringify(session),saved);
+});
