+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { ChatSnapshotSync } from '../src/renderer/chat-snapshot-sync';
+import type { ChatSnapshot } from '../src/shared/chat';
+test('late previous-worker completion cannot overwrite current worker state', async () => {
+  const make = (revision:number,workerGeneration:number,hostEpoch='a'):ChatSnapshot => ({sessionId:'s',messages:[],pending:[],taskState:'thinking',version:{hostEpoch,revision,eventSequence:revision,conversationId:'c',workerGeneration}});
+  const queue=[make(1,3),{...make(2,2),taskState:'completed' as const},make(3,3),make(1,1,'b')],seen:ChatSnapshot[]=[];
+  const sync=new ChatSnapshotSync('s',{read:async()=>queue.shift()!,apply:snapshot=>seen.push(snapshot),state:()=>{}});
+  try { await sync.refresh();await sync.refresh();assert.deepEqual(seen.map(item=>item.version?.workerGeneration),[3,3]);await sync.refresh();assert.equal(sync.snapshot?.version?.hostEpoch,'b'); }
+  finally {sync.dispose();}
+});
