+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {createLocalToolPort} from '../dist/tools/local-tools.js';
+test('local approval inputDigest remains compatible after serializer extraction',async()=>{
+ const root=await fs.mkdtemp(path.join(os.tmpdir(),'e0-digest-'));
+ try {await fs.writeFile(path.join(root,'x.txt'),'x');const tool=createLocalToolPort({projectRoot:root,ownerId:'owner',supervisor:{}});
+ const context={identity:{sessionId:'s',conversationId:'c',runId:'r',requestId:'q',workerGeneration:1},policyRevision:'policy',signal:new AbortController().signal,maxOutputBytes:65536};
+ const prepared=await tool.prepare({id:'read',name:'read_file',arguments:'{"maxBytes":20,"path":"x.txt"}'},context);
+ assert.equal(prepared.inputDigest,createHash('sha256').update('{"maxBytes":20,"path":"x.txt"}').digest('hex'));assert.equal(prepared.requiresApproval,false);
+ }finally{await fs.rm(root,{recursive:true,force:true});}
+});
