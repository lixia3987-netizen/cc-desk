+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {canonicalJson} from '../dist/index.js';
+import {canonicalJson as runJson} from '../dist/run.js';
+import {canonicalJson as sharedJson} from '../dist/canonical-json.js';
+test('public paths retain exact canonical JSON behavior',()=>{
+  assert.equal(canonicalJson,runJson);assert.equal(canonicalJson,sharedJson);
+  assert.equal(canonicalJson({z:[-0,'中文'],a:{b:true,a:null}}),' {"a":{"a":null,"b":true},"z":[0,"中文"]}'.trim());
+  assert.throws(()=>canonicalJson(Infinity),/Non-finite JSON number/);assert.throws(()=>canonicalJson(undefined),/Non-JSON value/);
+});
